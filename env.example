# Скопируйте этот файл в .env и заполните реальными значениями.
# .env в git не попадает (см. .gitignore).

# Telegram-уведомления об ошибках
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Почтовые уведомления о новых обновлениях
EMAIL_SERVER=
EMAIL_FROM=
EMAIL_TO=

# Список серверов (через запятую), куда копируются скачанные обновления
SERVERS=

# Источник обновлений M.E.Doc
URL_UPDATES=https://medoc.ua/download
